  <Properties>
    <Name>白绮：为我前驱</Name>
    <Description>白绮领袖原型：自动内政，军队由玩家指挥。开发版本。</Description>
    <Teaser>自动生产、建设与和平扩张。</Teaser>
    <Authors>XenoAmess</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <FrontEndActions>
    <ImportFiles id="BaiqiFrontArt">
      <File>Art/Baiqi_SelectionForeground.dds</File>
